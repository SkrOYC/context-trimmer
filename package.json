{
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@earendil-works/pi-coding-agent": "0.80.3",
    "@types/bun": "latest",
    "typebox": "^1.3.4",
    "ultracite": "7.9.0"
  },
  "name": "context-trimmer",
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "benchmark": "bun run benchmark/index.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "check": "bunx --bun @biomejs/biome check",
    "fix": "bunx --bun @biomejs/biome check --write",
    "format": "bunx --bun @biomejs/biome format --write"
  },
  "type": "module",
  "module": "index.ts",
  "private": true,
  "pi": {
    "extensions": [
      "./src/index.ts",
      "./pig"
    ]
  }
}
